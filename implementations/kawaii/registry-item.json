{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "kawaii",
  "type": "registry:theme",
  "title": "Kawaii",
  "description": "Pastel, round, and smiling. Every object can have a face.",
  "cssVars": {
    "theme": {
      "font-sans": "ui-rounded, \"Hiragino Maru Gothic ProN\", Nunito, Quicksand, \"Segoe UI\", system-ui, sans-serif",
      "font-mono": "ui-rounded, \"Hiragino Maru Gothic ProN\", \"Arial Rounded MT Bold\", Nunito, system-ui, sans-serif"
    },
    "light": {
      "background": "#fff6f9",
      "foreground": "#5b3a4a",
      "card": "#ffffff",
      "card-foreground": "#5b3a4a",
      "popover": "#ffffff",
      "popover-foreground": "#5b3a4a",
      "primary": "#ff9ec7",
      "primary-foreground": "#5b3a4a",
      "secondary": "#8fe3c4",
      "secondary-foreground": "#5b3a4a",
      "muted": "#ffe4ee",
      "muted-foreground": "#7d5a6a",
      "accent": "#ffe08a",
      "accent-foreground": "#5b3a4a",
      "destructive": "#b42318",
      "border": "#5b3a4a",
      "input": "#5b3a4a",
      "ring": "#ff9ec7",
      "radius": "28px"
    }
  }
}
