  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Optima",
        "Candara",
        "Segoe UI",
        "URW Classico",
        "sans-serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Iowan Old Style",
        "Palatino",
        "Palatino Linotype",
        "Book Antiqua",
        "Georgia",
        "serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Optima",
        "Candara",
        "Segoe UI",
        "sans-serif"
      ]
    }
  },
  "font-weight": {
    "regular": {
      "$type": "fontWeight",
