  "leading": {
    "tight": {
      "$type": "number",
      "$value": 1.05
    },
    "body": {
      "$type": "number",
      "$value": 1.6
    }
  },
  "tracking": {
    "display": {
      "$type": "number",
      "$value": 0,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "number",
      "$value": 0.01,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "label": {
      "$type": "number",
      "$value": 0.06,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "Leaf corner: applied to two opposite corners only."
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 160,
        "unit": "px"
      },
      "$description": "Arch: applied to the two top corners of a panel."
    },
    "pill": {
      "$type": "dimension",
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
