{
  "$description": "Risograph design tokens (DTCG 2025.10). Copyright (c) 2026 Switchback Solutions LLC. MIT License: https://field-guide-to-style.alec-5fe.workers.dev/rights.html#license",
  "color": {
    "bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9647,
          0.9451,
          0.9059
        ],
        "hex": "#f6f1e7"
      },
      "$description": "Uncoated off-white paper."
    },
    "surface": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9647,
          0.9451,
          0.9059
        ],
        "hex": "#f6f1e7"
      }
    },
    "subtle": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9255,
          0.8941,
          0.8314
        ],
        "hex": "#ece4d4"
      }
    },
    "text": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1686,
          0.2275,
          0.4392
        ],
        "hex": "#2b3a70"
      },
      "$description": "Dark blue ink used for text. Riso prints often have no black drum."
    },
    "muted": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3098,
          0.3529,
          0.549
        ],
        "hex": "#4f5a8c"
      }
    },
    "border": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1686,
          0.2275,
          0.4392
        ],
        "hex": "#2b3a70"
      }
    },
    "primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.2824,
          0.6902
        ],
        "hex": "#ff48b0"
      },
      "$description": "Screen approximation of Riso Fluorescent Pink ink."
    },
    "on-primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1686,
          0.2275,
          0.4392
        ],
        "hex": "#2b3a70"
      }
    },
    "primary-tint": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.6392,
          0.8471
        ],
        "hex": "#ffa3d8"
      },
      "$description": "Pink ink printed as a 50% screen."
    },
    "secondary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.4706,
          0.749
        ],
        "hex": "#0078bf"
      },
      "$description": "Screen approximation of Riso Blue ink."
    },
    "on-secondary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9647,
          0.9451,
          0.9059
        ],
        "hex": "#f6f1e7"
      }
    },
    "secondary-tint": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.498,
          0.7333,
          0.8745
        ],
        "hex": "#7fbbdf"
      },
      "$description": "Blue ink printed as a 50% screen."
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.9098,
          0
        ],
        "hex": "#ffe800"
      },
      "$description": "Screen approximation of Riso Yellow ink. An optional third ink: the specimen uses only pink and blue."
    },
    "on-accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1686,
          0.2275,
          0.4392
        ],
        "hex": "#2b3a70"
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Avenir Next Condensed",
        "Arial Narrow",
        "Roboto Condensed",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Helvetica Neue",
        "Arial",
        "Liberation Sans",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Courier New",
        "Courier",
        "Liberation Mono",
        "monospace"
      ]
    }
  },
  "font-weight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700
    },
    "display": {
      "$type": "fontWeight",
      "$value": 800
    }
  },
  "text": {
    "xs": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "base": {
      "$type": "dimension",
      "$value": {
        "value": 17,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 21,
        "unit": "px"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 28,
        "unit": "px"
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": {
        "value": 38,
        "unit": "px"
      }
    },
    "3xl": {
      "$type": "dimension",
      "$value": {
        "value": 56,
        "unit": "px"
      }
    },
    "4xl": {
      "$type": "dimension",
      "$value": {
        "value": 84,
        "unit": "px"
      }
    },
    "5xl": {
      "$type": "dimension",
      "$value": {
        "value": 128,
        "unit": "px"
      }
    }
  },
  "leading": {
    "tight": {
      "$type": "number",
      "$value": 0.95
    },
    "body": {
      "$type": "number",
      "$value": 1.5
    }
  },
  "tracking": {
    "display": {
      "$type": "number",
      "$value": -0.01,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "number",
      "$value": 0,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "label": {
      "$type": "number",
      "$value": 0.08,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "pill": {
      "$type": "dimension",
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "border-width": {
    "thin": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "thick": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    }
  },
  "spacing": {
    "xs": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 40,
        "unit": "px"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": {
        "value": 104,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.5xl}",
        "fontWeight": "{font-weight.display}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.display}"
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.2xl}",
        "fontWeight": "{font-weight.bold}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.heading}"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "{text.base}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "{text.xs}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}",
        "letterSpacing": "{tracking.label}"
      }
    }
  }
}
