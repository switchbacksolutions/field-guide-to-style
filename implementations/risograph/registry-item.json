{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "risograph",
  "type": "registry:theme",
  "title": "Risograph",
  "description": "Two or three fluorescent and spot inks, overprinted, grainy, and slightly out of register. The look of the zine-fair table.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Helvetica Neue\", Arial, \"Liberation Sans\", sans-serif",
      "font-mono": "\"Courier New\", Courier, \"Liberation Mono\", monospace"
    },
    "light": {
      "background": "#f6f1e7",
      "foreground": "#2b3a70",
      "card": "#f6f1e7",
      "card-foreground": "#2b3a70",
      "popover": "#f6f1e7",
      "popover-foreground": "#2b3a70",
      "primary": "#ff48b0",
      "primary-foreground": "#2b3a70",
      "secondary": "#0078bf",
      "secondary-foreground": "#f6f1e7",
      "muted": "#ece4d4",
      "muted-foreground": "#4f5a8c",
      "accent": "#ffe800",
      "accent-foreground": "#2b3a70",
      "destructive": "#b42318",
      "border": "#2b3a70",
      "input": "#2b3a70",
      "ring": "#ff48b0",
      "radius": "4px"
    }
  }
}
