{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "bento-grid",
  "type": "registry:theme",
  "title": "Bento grid",
  "description": "Rounded tiles of different sizes in one tight grid, one fact per tile. The look of Apple’s keynote summary slides.",
  "cssVars": {
    "theme": {
      "font-sans": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif",
      "font-mono": "\"SF Mono\", ui-monospace, Menlo, Consolas, monospace"
    },
    "light": {
      "background": "#f5f5f7",
      "foreground": "#1d1d1f",
      "card": "#ffffff",
      "card-foreground": "#1d1d1f",
      "popover": "#ffffff",
      "popover-foreground": "#1d1d1f",
      "primary": "#0071e3",
      "primary-foreground": "#ffffff",
      "secondary": "#1d1d1f",
      "secondary-foreground": "#f5f5f7",
      "muted": "#e8e8ed",
      "muted-foreground": "#6e6e73",
      "accent": "#bf4800",
      "accent-foreground": "#ffffff",
      "destructive": "#b42318",
      "border": "#d2d2d7",
      "input": "#d2d2d7",
      "ring": "#0071e3",
      "radius": "20px"
    }
  }
}
