{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "victorian-typography",
  "type": "registry:theme",
  "title": "Victorian typography",
  "description": "A centred stack of fat faces, slabs, and condensed gothics, every line in a different letter. The jobbing printer's poster.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Century Schoolbook\", Georgia, \"DejaVu Serif\", serif",
      "font-mono": "\"Courier New\", Courier, \"Liberation Mono\", monospace"
    },
    "light": {
      "background": "#efe4cc",
      "foreground": "#1b1712",
      "card": "#f6eedb",
      "card-foreground": "#1b1712",
      "popover": "#f6eedb",
      "popover-foreground": "#1b1712",
      "primary": "#b3261e",
      "primary-foreground": "#f6eedb",
      "secondary": "#1b1712",
      "secondary-foreground": "#f6eedb",
      "muted": "#e3d3b0",
      "muted-foreground": "#4b4236",
      "accent": "#1f3a6e",
      "accent-foreground": "#f6eedb",
      "destructive": "#b42318",
      "border": "#1b1712",
      "input": "#1b1712",
      "ring": "#b3261e",
      "radius": "0px"
    }
  }
}
