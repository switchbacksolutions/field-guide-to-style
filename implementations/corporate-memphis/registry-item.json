{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "corporate-memphis",
  "type": "registry:theme",
  "title": "Corporate Memphis",
  "description": "Flat cartoon people with small heads, long bendy limbs, and purple or blue skin. The friendly face of Big Tech.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Avenir Next\", Nunito, \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif",
      "font-mono": "\"SF Mono\", Menlo, Consolas, monospace"
    },
    "light": {
      "background": "#fffaf4",
      "foreground": "#1d1b4f",
      "card": "#ffffff",
      "card-foreground": "#1d1b4f",
      "popover": "#ffffff",
      "popover-foreground": "#1d1b4f",
      "primary": "#6147ff",
      "primary-foreground": "#ffffff",
      "secondary": "#ff6a4d",
      "secondary-foreground": "#1d1b4f",
      "muted": "#eee9ff",
      "muted-foreground": "#4b4878",
      "accent": "#ffc233",
      "accent-foreground": "#1d1b4f",
      "destructive": "#b42318",
      "border": "#d8d2f7",
      "input": "#d8d2f7",
      "ring": "#6147ff",
      "radius": "24px"
    }
  }
}
