    }
  },
  "tracking": {
    "display": {
      "$type": "number",
      "$value": -0.045,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "number",
      "$value": -0.02,
      "$extensions": {
        "style-inspiration": {
