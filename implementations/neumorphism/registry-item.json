{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "neumorphism",
  "type": "registry:theme",
  "title": "Neumorphism",
  "description": "Soft, extruded controls pressed out of one pale surface. Light and shadow instead of color.",
  "cssVars": {
    "theme": {
      "font-sans": "Nunito, \"Avenir Next\", \"Segoe UI\", system-ui, -apple-system, \"Helvetica Neue\", sans-serif",
      "font-mono": "\"SF Mono\", Menlo, Consolas, monospace",
      "shadow-sm": "5px 5px 10px 0px #a3b1c6, -5px -5px 10px 0px #ffffff",
      "shadow-md": "10px 10px 20px 0px #a3b1c6, -10px -10px 20px 0px #ffffff"
    },
    "light": {
      "background": "#e4e9f0",
      "foreground": "#31344b",
      "card": "#e4e9f0",
      "card-foreground": "#31344b",
      "popover": "#e4e9f0",
      "popover-foreground": "#31344b",
      "primary": "#4d5ee8",
      "primary-foreground": "#ffffff",
      "secondary": "#e4e9f0",
      "secondary-foreground": "#31344b",
      "muted": "#dde3eb",
      "muted-foreground": "#565c73",
      "accent": "#4d5ee8",
      "accent-foreground": "#ffffff",
      "destructive": "#b42318",
      "border": "#d1d9e6",
      "input": "#d1d9e6",
      "ring": "#4d5ee8",
      "radius": "20px"
    }
  }
}
