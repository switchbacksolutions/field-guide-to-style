  "cssVars": {
    "theme": {
      "font-sans": "Verdana, Tahoma, Geneva, sans-serif",
      "font-mono": "\"OCR A Std\", \"OCR A Extended\", \"Andale Mono\", Menlo, monospace"
    },
    "light": {
      "background": "#dfe4ea",
      "foreground": "#0d1330",
      "card": "#f4f6f9",
      "card-foreground": "#0d1330",
      "popover": "#f4f6f9",
      "popover-foreground": "#0d1330",
      "primary": "#0079a8",
      "primary-foreground": "#ffffff",
      "secondary": "#ff6a13",
      "secondary-foreground": "#0d1330",
      "muted": "#c9d0d9",
      "muted-foreground": "#3c4566",
      "accent": "#a6e22e",
      "accent-foreground": "#0d1330",
      "destructive": "#b42318",
