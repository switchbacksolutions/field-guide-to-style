  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Impact",
        "Haettenschweiler",
        "Arial Black",
        "sans-serif"
      ],
      "$description": "Heavy poster grotesque from the jobbing case."
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Georgia",
        "Times New Roman",
        "serif"
      ],
      "$description": "Plain newspaper roman for running text."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Courier New",
        "Courier",
        "monospace"
      ]
    },
    "serif": {
