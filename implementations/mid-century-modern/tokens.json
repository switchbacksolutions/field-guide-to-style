  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Futura",
        "Century Gothic",
        "Avenir Next",
        "Trebuchet MS",
        "sans-serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Iowan Old Style",
        "Palatino",
        "Book Antiqua",
        "Georgia",
        "serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Futura",
        "Century Gothic",
        "Avenir Next",
        "sans-serif"
