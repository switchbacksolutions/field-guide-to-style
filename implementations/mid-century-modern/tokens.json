      "$value": 1.55
    }
  },
  "tracking": {
    "display": {
      "$type": "number",
      "$value": -0.01,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "number",
      "$value": 0,
      "$extensions": {
