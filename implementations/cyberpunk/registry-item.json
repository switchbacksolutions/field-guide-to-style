{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "cyberpunk",
  "type": "registry:theme",
  "title": "Cyberpunk",
  "description": "Neon signs in a wet black night, terminal text, and heads-up displays. High tech, low life.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Cascadia Mono\", \"JetBrains Mono\", Consolas, Menlo, \"DejaVu Sans Mono\", \"Courier New\", monospace",
      "font-mono": "\"Cascadia Mono\", \"JetBrains Mono\", Consolas, Menlo, \"DejaVu Sans Mono\", \"Courier New\", monospace",
      "shadow-sm": "0px 0px 6px 0px #00e5ff80",
      "shadow-md": "0px 0px 14px 0px #00e5ff59, inset 0px 0px 2px 0px #00e5ff26"
    },
    "light": {
      "background": "#07080d",
      "foreground": "#d8f3ff",
      "card": "#0d1119",
      "card-foreground": "#d8f3ff",
      "popover": "#0d1119",
      "popover-foreground": "#d8f3ff",
      "primary": "#fcee0a",
      "primary-foreground": "#07080d",
      "secondary": "#00e5ff",
      "secondary-foreground": "#07080d",
      "muted": "#151b27",
      "muted-foreground": "#93a9bf",
      "accent": "#ff2a6d",
      "accent-foreground": "#07080d",
      "destructive": "#b42318",
      "border": "#1f6f86",
      "input": "#1f6f86",
      "ring": "#fcee0a",
      "radius": "0px"
    }
  }
}
