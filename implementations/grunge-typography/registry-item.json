{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "grunge-typography",
  "type": "registry:theme",
  "title": "Grunge typography",
  "description": "Distressed letters, clashing typefaces, and photocopied layers. Type as noise and emotion.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Times New Roman\", Times, serif",
      "font-serif": "Didot, \"Bodoni 72\", \"Bodoni MT\", serif",
      "font-mono": "\"American Typewriter\", \"Courier New\", Courier, monospace"
    },
    "light": {
      "background": "#d6cdb8",
      "foreground": "#1a1814",
      "card": "#e8e1d0",
      "card-foreground": "#1a1814",
      "popover": "#e8e1d0",
      "popover-foreground": "#1a1814",
      "primary": "#a13c22",
      "primary-foreground": "#efe8d8",
      "secondary": "#1a1814",
      "secondary-foreground": "#e8e1d0",
      "muted": "#b9ad93",
      "muted-foreground": "#4d463b",
      "accent": "#c39a3c",
      "accent-foreground": "#1a1814",
      "destructive": "#b42318",
      "border": "#1a1814",
      "input": "#1a1814",
      "ring": "#a13c22",
      "radius": "0px"
    }
  }
}
