{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "de-stijl",
  "type": "registry:theme",
  "title": "De Stijl",
  "description": "Black lines, white planes, and blocks of red, yellow, and blue. Only horizontals and verticals.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Helvetica Neue\", Arial, sans-serif",
      "font-mono": "\"DIN Alternate\", \"Helvetica Neue\", Arial, sans-serif"
    },
    "light": {
      "background": "#f3f2ec",
      "foreground": "#111111",
      "card": "#ffffff",
      "card-foreground": "#111111",
      "popover": "#ffffff",
      "popover-foreground": "#111111",
      "primary": "#d8231b",
      "primary-foreground": "#ffffff",
      "secondary": "#1b3e94",
      "secondary-foreground": "#ffffff",
      "muted": "#d9d8d2",
      "muted-foreground": "#6b6a66",
      "accent": "#f4cd1b",
      "accent-foreground": "#111111",
      "destructive": "#b42318",
      "border": "#111111",
      "input": "#111111",
      "ring": "#d8231b",
      "radius": "0px"
    }
  }
}
