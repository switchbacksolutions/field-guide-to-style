{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "psychedelic-art",
  "type": "registry:theme",
  "title": "Psychedelic art",
  "description": "Vibrating complementary colors, swollen hand lettering, and every inch filled. The 1960s rock poster.",
  "cssVars": {
    "theme": {
      "font-sans": "Optima, Candara, \"Segoe UI\", \"Trebuchet MS\", sans-serif",
      "font-mono": "Optima, Candara, \"Segoe UI\", sans-serif",
      "shadow-md": "0px 0px 0px 8px #b8f02a, 0px 0px 0px 16px #ff3fa4"
    },
    "light": {
      "background": "#ff6a13",
      "foreground": "#240046",
      "card": "#4a0e8f",
      "card-foreground": "#240046",
      "popover": "#4a0e8f",
      "popover-foreground": "#240046",
      "primary": "#ff3fa4",
      "primary-foreground": "#240046",
      "secondary": "#2a4dff",
      "secondary-foreground": "#fff4d6",
      "muted": "#ffd21f",
      "muted-foreground": "#4a1a5e",
      "accent": "#b8f02a",
      "accent-foreground": "#240046",
      "destructive": "#b42318",
      "border": "#240046",
      "input": "#240046",
      "ring": "#ff3fa4",
      "radius": "40px"
    }
  }
}
