{
  "$description": "Vienna Secession design tokens (DTCG 2025.10). Copyright (c) 2026 Switchback Solutions LLC. MIT License: https://field-guide-to-style.alec-5fe.workers.dev/rights.html#license",
  "color": {
    "bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9804,
          0.9725,
          0.949
        ],
        "hex": "#faf8f2"
      },
      "$description": "White paper, as in Ver Sacrum and the Werkstätte catalogues."
    },
    "surface": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "subtle": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9255,
          0.9098,
          0.8627
        ],
        "hex": "#ece8dc"
      }
    },
    "text": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0667,
          0.0667,
          0.0667
        ],
        "hex": "#111111"
      },
      "$description": "Printer's black."
    },
    "muted": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3333,
          0.3216,
          0.2902
        ],
        "hex": "#55524a"
      }
    },
    "border": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0667,
          0.0667,
          0.0667
        ],
        "hex": "#111111"
      }
    },
    "primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0667,
          0.0667,
          0.0667
        ],
        "hex": "#111111"
      },
      "$description": "Black, the main colour of the square and the checkerboard."
    },
    "on-primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9804,
          0.9725,
          0.949
        ],
        "hex": "#faf8f2"
      }
    },
    "secondary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9804,
          0.9725,
          0.949
        ],
        "hex": "#faf8f2"
      },
      "$description": "White, the other half of the checkerboard."
    },
    "on-secondary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0667,
          0.0667,
          0.0667
        ],
        "hex": "#111111"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6902,
          0.5412,
          0.1804
        ],
        "hex": "#b08a2e"
      },
      "$description": "Gold leaf, used sparingly (Klimt, the Secession dome)."
    },
    "on-accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0667,
          0.0667,
          0.0667
        ],
        "hex": "#111111"
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Avenir Next Condensed",
        "DIN Condensed",
        "Arial Narrow",
        "Roboto Condensed",
        "sans-serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Baskerville",
        "Georgia",
        "Times New Roman",
        "serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Avenir Next Condensed",
        "DIN Condensed",
        "Arial Narrow",
        "sans-serif"
      ]
    }
  },
  "font-weight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 600
    },
    "display": {
      "$type": "fontWeight",
      "$value": 600
    }
  },
  "text": {
    "xs": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "base": {
      "$type": "dimension",
      "$value": {
        "value": 17,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 26,
        "unit": "px"
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": {
        "value": 34,
        "unit": "px"
      }
    },
    "3xl": {
      "$type": "dimension",
      "$value": {
        "value": 44,
        "unit": "px"
      }
    },
    "4xl": {
      "$type": "dimension",
      "$value": {
        "value": 60,
        "unit": "px"
      }
    },
    "5xl": {
      "$type": "dimension",
      "$value": {
        "value": 84,
        "unit": "px"
      }
    }
  },
  "leading": {
    "tight": {
      "$type": "number",
      "$value": 0.95
    },
    "body": {
      "$type": "number",
      "$value": 1.6
    }
  },
  "tracking": {
    "display": {
      "$type": "number",
      "$value": 0,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "number",
      "$value": 0.01,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "label": {
      "$type": "number",
      "$value": 0.04,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "pill": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    }
  },
  "border-width": {
    "thin": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "px"
      }
    },
    "thick": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  },
  "spacing": {
    "xs": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 40,
        "unit": "px"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 72,
        "unit": "px"
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": {
        "value": 112,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.5xl}",
        "fontWeight": "{font-weight.display}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.display}"
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.2xl}",
        "fontWeight": "{font-weight.bold}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.heading}"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "{text.base}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "{text.xs}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}",
        "letterSpacing": "{tracking.label}"
      }
    }
  }
}
