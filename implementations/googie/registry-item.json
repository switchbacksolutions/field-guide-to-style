{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "googie",
  "type": "registry:theme",
  "title": "Googie",
  "description": "Neon signs, starbursts, boomerangs, and upswept angles in turquoise, flamingo pink, and tangerine. The space-age look of 1950s American coffee shops, motels, and roadside signs.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Avenir Next\", \"Century Gothic\", \"Trebuchet MS\", \"Helvetica Neue\", sans-serif",
      "font-mono": "Futura, \"Century Gothic\", \"Trebuchet MS\", sans-serif"
    },
    "light": {
      "background": "#0f1a33",
      "foreground": "#fbf3e2",
      "card": "#18284a",
      "card-foreground": "#fbf3e2",
      "popover": "#18284a",
      "popover-foreground": "#fbf3e2",
      "primary": "#ff4f9a",
      "primary-foreground": "#0f1a33",
      "secondary": "#2fd3c6",
      "secondary-foreground": "#0f1a33",
      "muted": "#223761",
      "muted-foreground": "#b8c3d9",
      "accent": "#ff8a1f",
      "accent-foreground": "#0f1a33",
      "destructive": "#b42318",
      "border": "#2fd3c6",
      "input": "#2fd3c6",
      "ring": "#ff4f9a",
      "radius": "10px"
    }
  }
}
