      "$type": "number",
      "$value": 1
    },
    "body": {
      "$type": "number",
      "$value": 1.5
    }
  },
  "tracking": {
    "display": {
      "$type": "number",
      "$value": 0.02,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "number",
      "$value": 0.04,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "label": {
      "$type": "number",
      "$value": 0.16,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    }
  },
  "radius": {
    "none": {
