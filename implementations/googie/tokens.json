  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Futura",
        "Century Gothic",
        "Avenir Next",
        "Trebuchet MS",
        "sans-serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Avenir Next",
        "Century Gothic",
        "Trebuchet MS",
        "Helvetica Neue",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Futura",
        "Century Gothic",
        "Trebuchet MS",
        "sans-serif"
      ]
    },
    "script": {
      "$type": "fontFamily",
      "$value": [
        "Brush Script MT",
        "Snell Roundhand",
        "Segoe Script",
        "cursive"
      ],
      "$description": "Neon script for one sign word at a time."
    }
  },
  "font-weight": {
