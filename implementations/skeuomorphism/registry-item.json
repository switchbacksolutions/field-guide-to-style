{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "skeuomorphism",
  "type": "registry:theme",
  "title": "Skeuomorphism",
  "description": "Leather, linen, wood, and paper on screen. Interfaces that imitate the objects they replace.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "font-serif": "Georgia, \"Times New Roman\", serif",
      "font-mono": "Menlo, Monaco, \"Courier New\", monospace",
      "shadow-sm": "0px 1px 2px 0px #00000059, inset 0px 1px 0px 0px #ffffff66",
      "shadow-md": "0px 3px 8px 0px #00000066, inset 0px 1px 0px 0px #ffffff40"
    },
    "light": {
      "background": "#cdd0d5",
      "foreground": "#262626",
      "card": "#ffffff",
      "card-foreground": "#262626",
      "popover": "#ffffff",
      "popover-foreground": "#262626",
      "primary": "#2a5fd0",
      "primary-foreground": "#ffffff",
      "secondary": "#6d84a2",
      "secondary-foreground": "#ffffff",
      "muted": "#e6e8eb",
      "muted-foreground": "#4c566c",
      "accent": "#5e3b22",
      "accent-foreground": "#f3e5c8",
      "destructive": "#b42318",
      "border": "#9ea3aa",
      "input": "#9ea3aa",
      "ring": "#2a5fd0",
      "radius": "8px"
    }
  }
}
