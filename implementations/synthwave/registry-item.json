{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "synthwave",
  "type": "registry:theme",
  "title": "Synthwave",
  "description": "Neon grids, striped sunsets, and chrome lettering on a black night sky. The 1980s remembered as a movie.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Avenir Next\", \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif",
      "font-mono": "Eurostile, Microgramma, \"Bank Gothic\", \"Arial Narrow\", sans-serif",
      "shadow-sm": "0px 0px 10px 0px #ff2bd6",
      "shadow-md": "0px 0px 4px 0px #ff2bd6, 0px 0px 22px 2px #ff2bd680"
    },
    "light": {
      "background": "#0d0221",
      "foreground": "#f5ecff",
      "card": "#160536",
      "card-foreground": "#f5ecff",
      "popover": "#160536",
      "popover-foreground": "#f5ecff",
      "primary": "#ff2bd6",
      "primary-foreground": "#0d0221",
      "secondary": "#2de2e6",
      "secondary-foreground": "#0d0221",
      "muted": "#2a0e5c",
      "muted-foreground": "#c2b0e8",
      "accent": "#ffb000",
      "accent-foreground": "#0d0221",
      "destructive": "#b42318",
      "border": "#ff2bd6",
      "input": "#ff2bd6",
      "ring": "#ff2bd6",
      "radius": "2px"
    }
  }
}
