{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "op-art",
  "type": "registry:theme",
  "title": "Op art",
  "description": "Black and white stripes, checks, and rings so tight that the surface seems to move. The 1960s optical look.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "font-mono": "\"Helvetica Neue\", Helvetica, Arial, sans-serif"
    },
    "light": {
      "background": "#ffffff",
      "foreground": "#000000",
      "card": "#ffffff",
      "card-foreground": "#000000",
      "popover": "#ffffff",
      "popover-foreground": "#000000",
      "primary": "#000000",
      "primary-foreground": "#ffffff",
      "secondary": "#ffffff",
      "secondary-foreground": "#000000",
      "muted": "#e6e6e6",
      "muted-foreground": "#3d3d3d",
      "accent": "#6b6b6b",
      "accent-foreground": "#ffffff",
      "destructive": "#b42318",
      "border": "#000000",
      "input": "#000000",
      "ring": "#000000",
      "radius": "0px"
    }
  }
}
