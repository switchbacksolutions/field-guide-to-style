  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Old English Text MT",
        "UnifrakturMaguntia",
        "Arial Black",
        "Helvetica Neue",
        "Arial",
        "Liberation Sans",
        "sans-serif"
      ],
      "$description": "Blackletter where the system has one, otherwise a heavy sans that the specimen stretches."
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Helvetica Neue",
        "Arial",
        "Liberation Sans",
        "Nimbus Sans",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Menlo",
        "Consolas",
        "DejaVu Sans Mono",
        "monospace"
