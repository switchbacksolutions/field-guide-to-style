{
  "$description": "Authored tokens for pixel-art. Shorthand values; tools/build.mjs writes DTCG 2025.10.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": "#fff1e8"
    },
    "surface": {
      "$value": "#fff1e8"
    },
    "subtle": {
      "$value": "#ffccaa",
      "$description": "Peach: alternate rows and the light dither step."
    },
    "text": {
      "$value": "#1d2b53",
      "$description": "Night blue: text, and the ground of title screens and dialogue boxes."
    },
    "muted": {
      "$value": "#5f574f"
    },
    "border": {
      "$value": "#000000",
      "$description": "Pixel outlines."
    },
    "primary": {
      "$value": "#ff004d"
    },
    "on-primary": {
      "$value": "#000000"
    },
    "secondary": {
      "$value": "#29adff"
    },
    "on-secondary": {
      "$value": "#000000"
    },
    "accent": {
      "$value": "#ffec27"
    },
    "on-accent": {
      "$value": "#000000"
    },
    "grass": {
      "$value": "#00e436",
      "$description": "Light step of the tiled ground strip."
    },
    "grass-dark": {
      "$value": "#008751",
      "$description": "Dark step of the tiled ground strip."
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Fixedsys",
        "Terminal",
        "Monaco",
        "Lucida Console",
        "Consolas",
        "DejaVu Sans Mono",
        "monospace"
      ],
      "$description": "Bitmap faces first. Every fallback is monospaced."
    },
    "body": {
      "$value": [
        "Monaco",
        "Lucida Console",
        "Consolas",
        "DejaVu Sans Mono",
        "Liberation Mono",
        "monospace"
      ]
    },
    "mono": {
      "$value": [
        "Fixedsys",
        "Terminal",
        "Monaco",
        "Lucida Console",
        "Consolas",
        "DejaVu Sans Mono",
        "monospace"
      ]
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "bold": {
      "$value": 700
    },
    "display": {
      "$value": 400,
      "$description": "Bitmap faces have one weight."
    }
  },
  "text": {
    "$type": "dimension",
    "xs": {
      "$value": "12px"
    },
    "sm": {
      "$value": "14px"
    },
    "base": {
      "$value": "16px"
    },
    "lg": {
      "$value": "20px"
    },
    "xl": {
      "$value": "24px"
    },
    "2xl": {
      "$value": "32px"
    },
    "3xl": {
      "$value": "40px"
    },
    "4xl": {
      "$value": "56px"
    },
    "5xl": {
      "$value": "72px"
    }
  },
  "leading": {
    "$type": "number",
    "tight": {
      "$value": 1.1
    },
    "body": {
      "$value": 1.6
    }
  },
  "tracking": {
    "$type": "number",
    "display": {
      "$value": 0.02,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "heading": {
      "$value": 0.04,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "label": {
      "$value": 0.08,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "sm": {
      "$value": "0px"
    },
    "md": {
      "$value": "0px"
    },
    "lg": {
      "$value": "0px"
    },
    "pill": {
      "$value": "0px"
    }
  },
  "border-width": {
    "$type": "dimension",
    "thin": {
      "$value": "4px",
      "$description": "One pixel unit."
    },
    "thick": {
      "$value": "8px"
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": "4px"
    },
    "sm": {
      "$value": "8px"
    },
    "md": {
      "$value": "16px"
    },
    "lg": {
      "$value": "32px"
    },
    "xl": {
      "$value": "64px"
    },
    "2xl": {
      "$value": "96px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": [
        {
          "color": "#000000",
          "offsetX": "4px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        },
        {
          "color": "#000000",
          "offsetX": "-4px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        },
        {
          "color": "#000000",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "0px",
          "spread": "0px"
        },
        {
          "color": "#000000",
          "offsetX": "0px",
          "offsetY": "-4px",
          "blur": "0px",
          "spread": "0px"
        }
      ],
      "$description": "Stepped outline: four hard one-unit offsets leave notched corners."
    },
    "md": {
      "$value": [
        {
          "color": "#000000",
          "offsetX": "4px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        },
        {
          "color": "#000000",
          "offsetX": "-4px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        },
        {
          "color": "#000000",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "0px",
          "spread": "0px"
        },
        {
          "color": "#000000",
          "offsetX": "0px",
          "offsetY": "-4px",
          "blur": "0px",
          "spread": "0px"
        },
        {
          "color": "#00000040",
          "offsetX": "0px",
          "offsetY": "-4px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        }
      ],
      "$description": "Stepped outline with a one-unit shade on the inside bottom. Move the shade to the top on press."
    },
    "lg": {
      "$value": [
        {
          "color": "#000000",
          "offsetX": "4px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        },
        {
          "color": "#000000",
          "offsetX": "-4px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        },
        {
          "color": "#000000",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "0px",
          "spread": "0px"
        },
        {
          "color": "#000000",
          "offsetX": "0px",
          "offsetY": "-4px",
          "blur": "0px",
          "spread": "0px"
        },
        {
          "color": "#00000040",
          "offsetX": "0px",
          "offsetY": "-4px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "#000000",
          "offsetX": "8px",
          "offsetY": "8px",
          "blur": "0px",
          "spread": "0px"
        }
      ],
      "$description": "Raised window: stepped outline plus a two-unit drop step."
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.5xl}",
        "fontWeight": "{font-weight.display}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.display}",
        "textTransform": "uppercase"
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.2xl}",
        "fontWeight": "{font-weight.display}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.heading}",
        "textTransform": "uppercase"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "{text.base}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "{text.xs}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}",
        "letterSpacing": "{tracking.label}",
        "textTransform": "uppercase"
      }
    }
  }
}
