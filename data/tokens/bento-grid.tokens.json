{
  "$description": "Authored tokens for bento-grid. Shorthand values; tools/build.mjs writes DTCG 2025.10.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": "#f5f5f7"
    },
    "surface": {
      "$value": "#ffffff"
    },
    "subtle": {
      "$value": "#e8e8ed"
    },
    "text": {
      "$value": "#1d1d1f"
    },
    "muted": {
      "$value": "#6e6e73"
    },
    "border": {
      "$value": "#d2d2d7"
    },
    "primary": {
      "$value": "#0071e3",
      "$description": "Link and action blue of Apple product pages."
    },
    "on-primary": {
      "$value": "#ffffff"
    },
    "secondary": {
      "$value": "#1d1d1f",
      "$description": "Dark tile on the light ground."
    },
    "on-secondary": {
      "$value": "#f5f5f7"
    },
    "accent": {
      "$value": "#bf4800",
      "$description": "One warm product-color tile."
    },
    "on-accent": {
      "$value": "#ffffff"
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "-apple-system",
        "BlinkMacSystemFont",
        "SF Pro Display",
        "Segoe UI",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "body": {
      "$value": [
        "-apple-system",
        "BlinkMacSystemFont",
        "SF Pro Text",
        "Segoe UI",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "SF Mono",
        "ui-monospace",
        "Menlo",
        "Consolas",
        "monospace"
      ]
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "bold": {
      "$value": 600
    },
    "display": {
      "$value": 700
    }
  },
  "text": {
    "$type": "dimension",
    "xs": {
      "$value": "12px"
    },
    "sm": {
      "$value": "14px"
    },
    "base": {
      "$value": "17px"
    },
    "lg": {
      "$value": "21px"
    },
    "xl": {
      "$value": "28px"
    },
    "2xl": {
      "$value": "40px"
    },
    "3xl": {
      "$value": "64px"
    },
    "4xl": {
      "$value": "96px"
    },
    "5xl": {
      "$value": "152px"
    }
  },
  "leading": {
    "$type": "number",
    "tight": {
      "$value": 1.0
    },
    "body": {
      "$value": 1.47
    }
  },
  "tracking": {
    "$type": "number",
    "display": {
      "$value": -0.04,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "heading": {
      "$value": -0.02,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "label": {
      "$value": 0,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "sm": {
      "$value": "12px"
    },
    "md": {
      "$value": "20px"
    },
    "lg": {
      "$value": "28px"
    },
    "pill": {
      "$value": "980px"
    }
  },
  "border-width": {
    "$type": "dimension",
    "thin": {
      "$value": "1px"
    },
    "thick": {
      "$value": "2px"
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": "8px"
    },
    "sm": {
      "$value": "16px"
    },
    "md": {
      "$value": "24px"
    },
    "lg": {
      "$value": "40px"
    },
    "xl": {
      "$value": "64px"
    },
    "2xl": {
      "$value": "104px"
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.5xl}",
        "fontWeight": "{font-weight.display}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.display}"
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.2xl}",
        "fontWeight": "{font-weight.bold}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.heading}"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "{text.base}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "{text.xs}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}",
        "letterSpacing": "{tracking.label}"
      }
    }
  }
}
