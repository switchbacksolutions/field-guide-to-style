{
  "$description": "Authored tokens for bauhaus. Shorthand values; tools/build.mjs writes DTCG 2025.10.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": "#f4efe6"
    },
    "surface": {
      "$value": "#f4efe6"
    },
    "subtle": {
      "$value": "#e7dfd0"
    },
    "text": {
      "$value": "#111111"
    },
    "muted": {
      "$value": "#474440"
    },
    "border": {
      "$value": "#111111"
    },
    "primary": {
      "$value": "#d42a20",
      "$description": "Red: square in Kandinsky's 1923 questionnaire."
    },
    "on-primary": {
      "$value": "#ffffff"
    },
    "secondary": {
      "$value": "#1f4e9c",
      "$description": "Blue: circle."
    },
    "on-secondary": {
      "$value": "#ffffff"
    },
    "accent": {
      "$value": "#f2c12e",
      "$description": "Yellow: triangle."
    },
    "on-accent": {
      "$value": "#111111"
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Futura",
        "Century Gothic",
        "Avenir Next",
        "Trebuchet MS",
        "sans-serif"
      ]
    },
    "body": {
      "$value": [
        "Avenir Next",
        "Futura",
        "Century Gothic",
        "Helvetica Neue",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "Futura",
        "Century Gothic",
        "sans-serif"
      ]
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "bold": {
      "$value": 700
    },
    "display": {
      "$value": 700
    }
  },
  "text": {
    "$type": "dimension",
    "xs": {
      "$value": "12px"
    },
    "sm": {
      "$value": "14px"
    },
    "base": {
      "$value": "17px"
    },
    "lg": {
      "$value": "21px"
    },
    "xl": {
      "$value": "28px"
    },
    "2xl": {
      "$value": "38px"
    },
    "3xl": {
      "$value": "56px"
    },
    "4xl": {
      "$value": "84px"
    },
    "5xl": {
      "$value": "128px"
    }
  },
  "leading": {
    "$type": "number",
    "tight": {
      "$value": 0.95
    },
    "body": {
      "$value": 1.5
    }
  },
  "tracking": {
    "$type": "number",
    "display": {
      "$value": -0.02,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "heading": {
      "$value": 0,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "label": {
      "$value": 0.14,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "sm": {
      "$value": "0px"
    },
    "md": {
      "$value": "0px"
    },
    "lg": {
      "$value": "0px"
    },
    "pill": {
      "$value": "0px"
    }
  },
  "border-width": {
    "$type": "dimension",
    "thin": {
      "$value": "2px"
    },
    "thick": {
      "$value": "10px"
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": "6px"
    },
    "sm": {
      "$value": "12px"
    },
    "md": {
      "$value": "24px"
    },
    "lg": {
      "$value": "40px"
    },
    "xl": {
      "$value": "64px"
    },
    "2xl": {
      "$value": "104px"
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.5xl}",
        "fontWeight": "{font-weight.display}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.display}"
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.2xl}",
        "fontWeight": "{font-weight.bold}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.heading}"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "{text.base}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "{text.xs}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}",
        "letterSpacing": "{tracking.label}"
      }
    }
  }
}
