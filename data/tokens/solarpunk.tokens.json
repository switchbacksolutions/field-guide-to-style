{
  "$description": "Authored tokens for solarpunk. Shorthand values; tools/build.mjs writes DTCG 2025.10.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#fbf8ec", "$description": "Warm, sunlit cream." },
    "surface": { "$value": "#ffffff" },
    "subtle": { "$value": "#e2f1d0", "$description": "Pale new-leaf green." },
    "text": { "$value": "#1d3326", "$description": "Deep forest green, used for text instead of black." },
    "muted": { "$value": "#4f6655" },
    "border": { "$value": "#2a5636", "$description": "Deep green outline, like the lead lines of stained glass." },
    "primary": { "$value": "#00a843", "$description": "Bright leaf green." },
    "on-primary": { "$value": "#10241a" },
    "secondary": { "$value": "#0b8fd0", "$description": "Clear sky and water blue." },
    "on-secondary": { "$value": "#ffffff" },
    "accent": { "$value": "#f5b922", "$description": "Sun gold." },
    "on-accent": { "$value": "#1d3326" }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Seravek", "Gill Sans", "Gill Sans MT", "Candara", "Segoe UI", "sans-serif"] },
    "body": { "$value": ["Charter", "Bitstream Charter", "Sitka Text", "Cambria", "Georgia", "serif"] },
    "mono": { "$value": ["Seravek", "Gill Sans", "Gill Sans MT", "Candara", "Segoe UI", "sans-serif"] }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "bold": { "$value": 600 },
    "display": { "$value": 600 }
  },
  "text": {
    "$type": "dimension",
    "xs": { "$value": "13px" },
    "sm": { "$value": "15px" },
    "base": { "$value": "18px" },
    "lg": { "$value": "21px" },
    "xl": { "$value": "26px" },
    "2xl": { "$value": "34px" },
    "3xl": { "$value": "46px" },
    "4xl": { "$value": "60px" },
    "5xl": { "$value": "78px" }
  },
  "leading": {
    "$type": "number",
    "tight": { "$value": 1.08 },
    "body": { "$value": 1.6 }
  },
  "tracking": {
    "$type": "number",
    "display": { "$value": -0.01, "$extensions": { "style-inspiration": { "unit": "em" } } },
    "heading": { "$value": 0, "$extensions": { "style-inspiration": { "unit": "em" } } },
    "label": { "$value": 0.04, "$extensions": { "style-inspiration": { "unit": "em" } } }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "10px" },
    "md": { "$value": "22px" },
    "lg": { "$value": "200px", "$description": "Arch or dome: applied to the two top corners of a panel." },
    "pill": { "$value": "999px" }
  },
  "border-width": {
    "$type": "dimension",
    "thin": { "$value": "2px" },
    "thick": { "$value": "4px", "$description": "Lead line around a stained-glass panel." }
  },
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": "6px" },
    "sm": { "$value": "12px" },
    "md": { "$value": "24px" },
    "lg": { "$value": "40px" },
    "xl": { "$value": "64px" },
    "2xl": { "$value": "104px" }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.display}", "fontSize": "{text.5xl}", "fontWeight": "{font-weight.display}", "lineHeight": "{leading.tight}", "letterSpacing": "{tracking.display}" } },
    "heading": { "$value": { "fontFamily": "{font.display}", "fontSize": "{text.2xl}", "fontWeight": "{font-weight.display}", "lineHeight": "{leading.tight}", "letterSpacing": "{tracking.heading}" } },
    "body": { "$value": { "fontFamily": "{font.body}", "fontSize": "{text.base}", "fontWeight": "{font-weight.regular}", "lineHeight": "{leading.body}" } },
    "label": { "$value": { "fontFamily": "{font.mono}", "fontSize": "{text.xs}", "fontWeight": "{font-weight.bold}", "lineHeight": "{leading.body}", "letterSpacing": "{tracking.label}" } }
  }
}
