{
  "$description": "Authored tokens for memphis. Shorthand values; tools/build.mjs writes DTCG 2025.10.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": "#fffdf6"
    },
    "surface": {
      "$value": "#ffffff"
    },
    "subtle": {
      "$value": "#fff1c1"
    },
    "text": {
      "$value": "#111111"
    },
    "muted": {
      "$value": "#3a3a3a"
    },
    "border": {
      "$value": "#111111"
    },
    "primary": {
      "$value": "#ff4f9a",
      "$description": "Hot pink."
    },
    "on-primary": {
      "$value": "#111111"
    },
    "secondary": {
      "$value": "#00b3a7",
      "$description": "Turquoise."
    },
    "on-secondary": {
      "$value": "#111111"
    },
    "accent": {
      "$value": "#ffd23f",
      "$description": "Yellow."
    },
    "on-accent": {
      "$value": "#111111"
    },
    "violet": {
      "$value": "#7c4dff"
    },
    "red": {
      "$value": "#ff3b30"
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Futura",
        "Avenir Next",
        "Trebuchet MS",
        "sans-serif"
      ]
    },
    "body": {
      "$value": [
        "Avenir Next",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "Avenir Next",
        "Helvetica Neue",
        "sans-serif"
      ]
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "bold": {
      "$value": 700
    },
    "display": {
      "$value": 800
    }
  },
  "text": {
    "$type": "dimension",
    "xs": {
      "$value": "12px"
    },
    "sm": {
      "$value": "14px"
    },
    "base": {
      "$value": "17px"
    },
    "lg": {
      "$value": "21px"
    },
    "xl": {
      "$value": "28px"
    },
    "2xl": {
      "$value": "40px"
    },
    "3xl": {
      "$value": "56px"
    },
    "4xl": {
      "$value": "80px"
    },
    "5xl": {
      "$value": "120px"
    }
  },
  "leading": {
    "$type": "number",
    "tight": {
      "$value": 0.95
    },
    "body": {
      "$value": 1.5
    }
  },
  "tracking": {
    "$type": "number",
    "display": {
      "$value": -0.02,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "heading": {
      "$value": 0,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "label": {
      "$value": 0.12,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "sm": {
      "$value": "0px"
    },
    "md": {
      "$value": "0px"
    },
    "lg": {
      "$value": "0px"
    },
    "pill": {
      "$value": "999px"
    }
  },
  "border-width": {
    "$type": "dimension",
    "thin": {
      "$value": "2px"
    },
    "thick": {
      "$value": "4px"
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": "6px"
    },
    "sm": {
      "$value": "12px"
    },
    "md": {
      "$value": "24px"
    },
    "lg": {
      "$value": "40px"
    },
    "xl": {
      "$value": "64px"
    },
    "2xl": {
      "$value": "100px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "md": {
      "$value": {
        "color": "#111111",
        "offsetX": "8px",
        "offsetY": "8px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "Offset black block, used as a graphic shape, not as depth."
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.5xl}",
        "fontWeight": "{font-weight.display}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.display}"
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.2xl}",
        "fontWeight": "{font-weight.bold}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.heading}"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "{text.base}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "{text.xs}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}",
        "letterSpacing": "{tracking.label}"
      }
    }
  }
}
