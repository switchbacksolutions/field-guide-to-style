{
  "$description": "Authored tokens for minimalist-machine. Shorthand values; tools/build.mjs writes DTCG 2025.10.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": "#f7f7f2"
    },
    "surface": {
      "$value": "#ffffff"
    },
    "subtle": {
      "$value": "#e9ece3"
    },
    "text": {
      "$value": "#20231f"
    },
    "muted": {
      "$value": "#60655b"
    },
    "border": {
      "$value": "#c9cdc1"
    },
    "primary": {
      "$value": "#20231f"
    },
    "on-primary": {
      "$value": "#f7f7f2"
    },
    "accent": {
      "$value": "#d9fb66",
      "$description": "Signal lime. Use for one mark or state per view."
    },
    "on-accent": {
      "$value": "#20231f"
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Helvetica Neue",
        "Helvetica",
        "Arial",
        "sans-serif"
      ]
    },
    "body": {
      "$value": [
        "Helvetica Neue",
        "Helvetica",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "SFMono-Regular",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ],
      "$description": "Labels, values, dates, and object names."
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "bold": {
      "$value": 500
    },
    "display": {
      "$value": 500
    }
  },
  "text": {
    "$type": "dimension",
    "xs": {
      "$value": "12px"
    },
    "sm": {
      "$value": "13px"
    },
    "base": {
      "$value": "16px"
    },
    "lg": {
      "$value": "20px"
    },
    "xl": {
      "$value": "25px"
    },
    "2xl": {
      "$value": "32px"
    },
    "3xl": {
      "$value": "46px"
    },
    "4xl": {
      "$value": "64px"
    },
    "5xl": {
      "$value": "90px"
    }
  },
  "leading": {
    "$type": "number",
    "tight": {
      "$value": 1.02
    },
    "body": {
      "$value": 1.55
    }
  },
  "tracking": {
    "$type": "number",
    "display": {
      "$value": -0.06,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "heading": {
      "$value": -0.03,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "label": {
      "$value": 0.1,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "sm": {
      "$value": "0px"
    },
    "md": {
      "$value": "0px"
    },
    "lg": {
      "$value": "0px"
    },
    "pill": {
      "$value": "0px"
    }
  },
  "border-width": {
    "$type": "dimension",
    "thin": {
      "$value": "1px"
    },
    "thick": {
      "$value": "1px"
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": "6px"
    },
    "sm": {
      "$value": "12px"
    },
    "md": {
      "$value": "20px"
    },
    "lg": {
      "$value": "32px"
    },
    "xl": {
      "$value": "56px"
    },
    "2xl": {
      "$value": "88px"
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.5xl}",
        "fontWeight": "{font-weight.display}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.display}"
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.2xl}",
        "fontWeight": "{font-weight.bold}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.heading}"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "{text.base}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "{text.xs}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}",
        "letterSpacing": "{tracking.label}"
      }
    }
  }
}
