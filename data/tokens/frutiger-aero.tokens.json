{
  "$description": "Authored tokens for frutiger-aero. Shorthand values; tools/build.mjs writes DTCG 2025.10.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": "#e7f6ff"
    },
    "surface": {
      "$value": "#ffffffc2",
      "$description": "Translucent white glass."
    },
    "subtle": {
      "$value": "#d6effb"
    },
    "text": {
      "$value": "#0c2a47"
    },
    "muted": {
      "$value": "#3d6282"
    },
    "border": {
      "$value": "#ffffffe6"
    },
    "primary": {
      "$value": "#0b6fc4"
    },
    "on-primary": {
      "$value": "#ffffff"
    },
    "accent": {
      "$value": "#23801a"
    },
    "on-accent": {
      "$value": "#ffffff"
    },
    "sky": {
      "$value": "#9fdcff"
    },
    "water": {
      "$value": "#34b6e4"
    },
    "leaf": {
      "$value": "#7ed957"
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Frutiger",
        "Segoe UI",
        "Myriad Pro",
        "Lucida Grande",
        "Helvetica Neue",
        "sans-serif"
      ]
    },
    "body": {
      "$value": [
        "Segoe UI",
        "Frutiger",
        "Myriad Pro",
        "Lucida Grande",
        "Helvetica Neue",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "Segoe UI",
        "Lucida Grande",
        "sans-serif"
      ]
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "bold": {
      "$value": 600
    },
    "display": {
      "$value": 300
    }
  },
  "text": {
    "$type": "dimension",
    "xs": {
      "$value": "12px"
    },
    "sm": {
      "$value": "14px"
    },
    "base": {
      "$value": "16px"
    },
    "lg": {
      "$value": "19px"
    },
    "xl": {
      "$value": "24px"
    },
    "2xl": {
      "$value": "32px"
    },
    "3xl": {
      "$value": "44px"
    },
    "4xl": {
      "$value": "60px"
    },
    "5xl": {
      "$value": "80px"
    }
  },
  "leading": {
    "$type": "number",
    "tight": {
      "$value": 1.05
    },
    "body": {
      "$value": 1.55
    }
  },
  "tracking": {
    "$type": "number",
    "display": {
      "$value": -0.02,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "heading": {
      "$value": -0.01,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "label": {
      "$value": 0.02,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "sm": {
      "$value": "6px"
    },
    "md": {
      "$value": "12px"
    },
    "lg": {
      "$value": "20px"
    },
    "pill": {
      "$value": "999px"
    }
  },
  "border-width": {
    "$type": "dimension",
    "thin": {
      "$value": "1px"
    },
    "thick": {
      "$value": "2px"
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": "6px"
    },
    "sm": {
      "$value": "12px"
    },
    "md": {
      "$value": "20px"
    },
    "lg": {
      "$value": "32px"
    },
    "xl": {
      "$value": "56px"
    },
    "2xl": {
      "$value": "88px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": "#0c2a4733",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "3px",
        "spread": "0px"
      }
    },
    "md": {
      "$value": {
        "color": "#0c2a4733",
        "offsetX": "0px",
        "offsetY": "10px",
        "blur": "30px",
        "spread": "0px"
      }
    },
    "glow": {
      "$value": {
        "color": "#9fdcffcc",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "18px",
        "spread": "0px"
      }
    }
  },
  "gradient": {
    "$type": "gradient",
    "sky": {
      "$value": {
        "angle": "180deg",
        "stops": [
          {
            "color": "#8fd3ff",
            "position": 0
          },
          {
            "color": "#e7f6ff",
            "position": 0.55
          },
          {
            "color": "#ffffff",
            "position": 1
          }
        ]
      }
    },
    "button": {
      "$value": {
        "angle": "180deg",
        "stops": [
          {
            "color": "#5cb8ff",
            "position": 0
          },
          {
            "color": "#1a86de",
            "position": 0.5
          },
          {
            "color": "#0b6fc4",
            "position": 0.51
          },
          {
            "color": "#0a5fa8",
            "position": 1
          }
        ]
      },
      "$description": "Gloss: a hard light break at the midpoint."
    },
    "leaf-button": {
      "$value": {
        "angle": "180deg",
        "stops": [
          {
            "color": "#6fd24f",
            "position": 0
          },
          {
            "color": "#3a9f2a",
            "position": 0.5
          },
          {
            "color": "#23801a",
            "position": 0.51
          },
          {
            "color": "#1c6b14",
            "position": 1
          }
        ]
      }
    },
    "gloss": {
      "$value": {
        "angle": "180deg",
        "stops": [
          {
            "color": "#ffffffe6",
            "position": 0
          },
          {
            "color": "#ffffff33",
            "position": 1
          }
        ]
      }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.5xl}",
        "fontWeight": "{font-weight.display}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.display}"
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.2xl}",
        "fontWeight": "{font-weight.bold}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.heading}"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "{text.base}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "{text.xs}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}",
        "letterSpacing": "{tracking.label}"
      }
    }
  }
}
