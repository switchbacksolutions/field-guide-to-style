{
  "$description": "Authored tokens for international-typographic-style. Shorthand values; tools/build.mjs writes DTCG 2025.10.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": "#ffffff"
    },
    "surface": {
      "$value": "#ffffff"
    },
    "subtle": {
      "$value": "#f0f0f0"
    },
    "text": {
      "$value": "#111111"
    },
    "muted": {
      "$value": "#5c5c5c"
    },
    "border": {
      "$value": "#111111"
    },
    "primary": {
      "$value": "#e30613",
      "$description": "Signal red. One idea per view."
    },
    "on-primary": {
      "$value": "#ffffff"
    },
    "accent": {
      "$value": "#e30613"
    },
    "on-accent": {
      "$value": "#ffffff"
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Helvetica Neue",
        "Helvetica",
        "Arial",
        "sans-serif"
      ],
      "$description": "A grotesque: Helvetica, Akzidenz-Grotesk, or Univers when licensed."
    },
    "body": {
      "$value": [
        "Helvetica Neue",
        "Helvetica",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "Helvetica Neue",
        "Helvetica",
        "Arial",
        "sans-serif"
      ]
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "bold": {
      "$value": 700
    },
    "display": {
      "$value": 700
    }
  },
  "text": {
    "$type": "dimension",
    "xs": {
      "$value": "12px"
    },
    "sm": {
      "$value": "14px"
    },
    "base": {
      "$value": "16px"
    },
    "lg": {
      "$value": "20px"
    },
    "xl": {
      "$value": "28px"
    },
    "2xl": {
      "$value": "40px"
    },
    "3xl": {
      "$value": "64px"
    },
    "4xl": {
      "$value": "96px"
    },
    "5xl": {
      "$value": "160px"
    }
  },
  "leading": {
    "$type": "number",
    "tight": {
      "$value": 0.92
    },
    "body": {
      "$value": 1.4
    }
  },
  "tracking": {
    "$type": "number",
    "display": {
      "$value": -0.045,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "heading": {
      "$value": -0.02,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    },
    "label": {
      "$value": 0,
      "$extensions": {
        "style-inspiration": {
          "unit": "em"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "sm": {
      "$value": "0px"
    },
    "md": {
      "$value": "0px"
    },
    "lg": {
      "$value": "0px"
    },
    "pill": {
      "$value": "0px"
    }
  },
  "border-width": {
    "$type": "dimension",
    "thin": {
      "$value": "1px"
    },
    "thick": {
      "$value": "4px"
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": "6px"
    },
    "sm": {
      "$value": "12px"
    },
    "md": {
      "$value": "24px"
    },
    "lg": {
      "$value": "36px"
    },
    "xl": {
      "$value": "72px"
    },
    "2xl": {
      "$value": "120px"
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.5xl}",
        "fontWeight": "{font-weight.display}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.display}"
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.2xl}",
        "fontWeight": "{font-weight.bold}",
        "lineHeight": "{leading.tight}",
        "letterSpacing": "{tracking.heading}"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "{text.base}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "{text.xs}",
        "fontWeight": "{font-weight.regular}",
        "lineHeight": "{leading.body}",
        "letterSpacing": "{tracking.label}"
      }
    }
  }
}
