{
  "$description": "Authored tokens for vienna-secession. Shorthand values; tools/build.mjs writes DTCG 2025.10.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#faf8f2", "$description": "White paper, as in Ver Sacrum and the Werkstätte catalogues." },
    "surface": { "$value": "#ffffff" },
    "subtle": { "$value": "#ece8dc" },
    "text": { "$value": "#111111", "$description": "Printer's black." },
    "muted": { "$value": "#55524a" },
    "border": { "$value": "#111111" },
    "primary": { "$value": "#111111", "$description": "Black, the main colour of the square and the checkerboard." },
    "on-primary": { "$value": "#faf8f2" },
    "secondary": { "$value": "#faf8f2", "$description": "White, the other half of the checkerboard." },
    "on-secondary": { "$value": "#111111" },
    "accent": { "$value": "#b08a2e", "$description": "Gold leaf, used sparingly (Klimt, the Secession dome)." },
    "on-accent": { "$value": "#111111" }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Avenir Next Condensed", "DIN Condensed", "Arial Narrow", "Roboto Condensed", "sans-serif"] },
    "body": { "$value": ["Baskerville", "Georgia", "Times New Roman", "serif"] },
    "mono": { "$value": ["Avenir Next Condensed", "DIN Condensed", "Arial Narrow", "sans-serif"] }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "bold": { "$value": 600 },
    "display": { "$value": 600 }
  },
  "text": {
    "$type": "dimension",
    "xs": { "$value": "12px" },
    "sm": { "$value": "14px" },
    "base": { "$value": "17px" },
    "lg": { "$value": "20px" },
    "xl": { "$value": "26px" },
    "2xl": { "$value": "34px" },
    "3xl": { "$value": "44px" },
    "4xl": { "$value": "60px" },
    "5xl": { "$value": "84px" }
  },
  "leading": {
    "$type": "number",
    "tight": { "$value": 0.95 },
    "body": { "$value": 1.6 }
  },
  "tracking": {
    "$type": "number",
    "display": { "$value": 0, "$extensions": { "style-inspiration": { "unit": "em" } } },
    "heading": { "$value": 0.01, "$extensions": { "style-inspiration": { "unit": "em" } } },
    "label": { "$value": 0.04, "$extensions": { "style-inspiration": { "unit": "em" } } }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "0px" },
    "md": { "$value": "0px" },
    "lg": { "$value": "0px" },
    "pill": { "$value": "0px" }
  },
  "border-width": {
    "$type": "dimension",
    "thin": { "$value": "1px" },
    "thick": { "$value": "2px" }
  },
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": "6px" },
    "sm": { "$value": "12px" },
    "md": { "$value": "24px" },
    "lg": { "$value": "40px" },
    "xl": { "$value": "72px" },
    "2xl": { "$value": "112px" }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.display}", "fontSize": "{text.5xl}", "fontWeight": "{font-weight.display}", "lineHeight": "{leading.tight}", "letterSpacing": "{tracking.display}" } },
    "heading": { "$value": { "fontFamily": "{font.display}", "fontSize": "{text.2xl}", "fontWeight": "{font-weight.bold}", "lineHeight": "{leading.tight}", "letterSpacing": "{tracking.heading}" } },
    "body": { "$value": { "fontFamily": "{font.body}", "fontSize": "{text.base}", "fontWeight": "{font-weight.regular}", "lineHeight": "{leading.body}" } },
    "label": { "$value": { "fontFamily": "{font.mono}", "fontSize": "{text.xs}", "fontWeight": "{font-weight.regular}", "lineHeight": "{leading.body}", "letterSpacing": "{tracking.label}" } }
  }
}
